# QADM CLI - Slim CLI Client Image
# Lightweight CLI that communicates with agent via REST API.
# No JRE, no JT400, no ODBC — just pure Python for fast container startup.

FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src/ ./src/

RUN pip install --upgrade pip && \
    pip install -e .

RUN useradd -m -u 1000 qadmcli && \
    chown -R qadmcli:qadmcli /app

USER qadmcli
ENTRYPOINT ["qadmcli"]
CMD ["--help"]
