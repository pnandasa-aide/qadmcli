#ignore environment file
.env
#ignore comment,notes
*.txt
*.copy

# Ignore Syniti metadata and converted schemas (large files, regenerate as needed)
schemas/syniti/
schemas/converted/
schemas/converted_*/

# Ignore working data files
*.xml
# Ignore Python cache and compiled files
__pycache__/
*.pyc
*.pyo

# To remove files from index (cache) if needed:
# git rm -r --cached . --ignore-unmatch $(find . -name __pycache__ -type d)
